{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "宿主机挂载模板清单",
  "type": "object",
  "required": [
    "template_directories",
    "scripts",
    "config_files"
  ],
  "properties": {
    "template_directories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
