{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "模型包 manifest",
  "type": "object",
  "required": [
    "capability_name",
    "model_version",
    "source_train_task_id",
    "task_name",
    "backend_type",
    "artifact_path",
    "status",
    "checksum",
    "preprocessing",
    "thresholds",
    "labels",
    "validation",
    "delivery_metadata"
  ],
  "properties": {
    "capability_name": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "source_train_task_id": {
      "type": "integer"
    },
    "task_name": {
      "type": "string"
    },
    "backend_type": {
      "type": "string"
    },
    "artifact_path": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "checksum": {
      "type": "string"
    },
    "preprocessing": {
      "type": "object",
      "required": ["input_type", "resize", "normalize"],
      "properties": {
        "input_type": {
          "type": "string"
        },
        "resize": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          }
        },
        "normalize": {
          "type": "object",
          "required": ["mean", "std"],
          "properties": {
            "mean": {
              "type": "array",
              "items": { "type": "number" }
            },
            "std": {
              "type": "array",
              "items": { "type": "number" }
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "required": ["score_threshold", "nms_threshold"],
      "properties": {
        "score_threshold": { "type": "number" },
        "nms_threshold": { "type": "number" }
      }
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation": {
      "type": "object",
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "delivery_metadata": {
      "type": "object",
      "required": ["ai_test", "ai_builder", "training_summary"],
      "properties": {
        "ai_test": { "type": "object" },
        "ai_builder": { "type": "object" },
        "training_summary": { "type": "object" }
      }
    }
  }
}
